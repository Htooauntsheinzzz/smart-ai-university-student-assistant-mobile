<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc. The debug
         network security config permits plain HTTP to localhost /
         10.0.2.2 for the Spring Boot backend (DEC-010); release builds
         keep the default HTTPS-only policy. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <application
        tools:targetApi="24"
        android:networkSecurityConfig="@xml/network_security_config"/>
</manifest>
