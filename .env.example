# Copy this file to .env and adjust it. .env is git-ignored.
# Values are passed to the app with `--dart-define-from-file=.env`
# (scripts/run_physical.sh and the VS Code launch configs do this).

# Backend base URL. Leave empty to use the platform default for local
# development: http://localhost:8080 on iOS Simulator / macOS,
# http://10.0.2.2:8080 on an Android emulator.
# Release builds require an https URL, e.g. https://api.example.com
API_BASE_URL=
